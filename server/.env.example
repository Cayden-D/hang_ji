NODE_ENV=production
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=https://your-miniapp-domain.example.com

DB_HOST=mysql
DB_PORT=3306
DB_NAME=hangji
DB_USER=hangji
DB_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRES_IN=7d

# 钉钉企业内部应用凭证，只能配置在服务端。
DING_APP_KEY=dingxxxxxxxxxxxxxxxx
DING_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DING_CORP_ID=dingxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DING_AGENT_ID=123456789

# 首次免登时按 userId 自动分配角色，多个 ID 用英文逗号分隔。
DING_ADMIN_USER_IDS=
DING_PURCHASE_USER_IDS=
DING_LOGISTICS_USER_IDS=

# 小程序详情页路径，用于工作通知跳转。
DING_MINIAPP_APP_ID=
DING_MINIAPP_ORDER_PATH=pages/index/index?orderId=

# 阿里云 OSS。请使用仅有目标 Bucket 读写权限的 RAM 用户，不要使用主账号 AccessKey。
# Node.js SDK 的 Region 需要 oss- 前缀，例如 oss-cn-hangzhou。
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=your-ram-access-key-id
OSS_ACCESS_KEY_SECRET=your-ram-access-key-secret
# 自定义 Endpoint、内网 Endpoint 或传输加速场景填写；普通公网访问可留空。
OSS_ENDPOINT=
# 已在 OSS Bucket 绑定并配置 HTTPS 证书的自定义域名，例如 https://img.example.com。
# 配置后，上传地址和私有文件签名 URL 都会使用该域名。
OSS_CUSTOM_DOMAIN=
OSS_UPLOAD_DIR=hangji
# 私有 Bucket 图片签名地址有效期，单位秒。
OSS_DOWNLOAD_URL_TTL=3600
